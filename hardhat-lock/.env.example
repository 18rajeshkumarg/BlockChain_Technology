# Hardhat 3 Keystore Configuration
# These values are stored in the encrypted Hardhat keystore, NOT in .env files.
# To set them, run:
#   npx hardhat keystore set SEPOLIA_RPC_URL
#   npx hardhat keystore set SEPOLIA_PRIVATE_KEY
#   npx hardhat keystore set MAINNET_RPC_URL
#   npx hardhat keystore set MAINNET_PRIVATE_KEY

# Sepolia testnet RPC endpoint
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_API_KEY

# Sepolia testnet private key (test ETH only, no real value)
SEPOLIA_PRIVATE_KEY=0x...

# Ethereum Mainnet RPC endpoint (e.g., Infura, Alchemy, or public node)
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# Private key of the deployment account (with real ETH for gas)
# NEVER commit this value or share it
MAINNET_PRIVATE_KEY=0x...
